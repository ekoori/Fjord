<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Filenames are not ASCII. Invariant globalization would break sorting and casing. -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <!--
      IDE0005 (unused using) only runs on build when the documentation file is
      generated. We want the dead-code check, not the docs:
        CS1591 - member has no XML comment. Requiring one everywhere is noise.
        CS1573 - some parameters documented but not all. Documenting only the
                 parameter that is surprising is the house style; this warning
                 would force restating the obvious ones to say nothing.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Fjord</Product>
    <Company>Fjord</Company>
    <Authors>Igor</Authors>
    <Copyright>Copyright © Igor</Copyright>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

</Project>
