<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <!-- Windows only. Avalonia needs this for window transparency and embedded controls. -->
  <assemblyIdentity version="1.0.0.0" name="Fjord.App"/>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!--
        .NET only lifts the 260-character MAX_PATH limit when the process opts in here.
        Without it, enumerating a deep tree throws PathTooLongException from inside the
        enumerator and the pane simply looks empty, with nothing to explain why.

        This is necessary but not sufficient: the machine also needs
        HKLM\SYSTEM\CurrentControlSet\Control\FileSystem\LongPathsEnabled set to 1.
      -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
