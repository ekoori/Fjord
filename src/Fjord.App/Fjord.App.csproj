<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The .exe icon on Windows. The window icon is set separately, in code. -->
    <ApplicationIcon>Assets/fjord.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyTitle>Fjord</AssemblyTitle>
    <RootNamespace>Fjord.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded so the window icon works from a single-file publish too. -->
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <!--
      The abstractions plus LoggerFactory, and nothing else. Not Logging.Console: it drags
      Configuration, Options and a formatter stack in to write to a console a WinExe has not
      got. The rolling-file provider under Logging/ is the only one shipped.
    -->
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fjord.Commands\Fjord.Commands.csproj" />
    <ProjectReference Include="..\Fjord.Config\Fjord.Config.csproj" />
    <ProjectReference Include="..\Fjord.Core\Fjord.Core.csproj" />
    <ProjectReference Include="..\Fjord.Operations\Fjord.Operations.csproj" />
    <ProjectReference Include="..\Fjord.Platform\Fjord.Platform.csproj" />
    <ProjectReference Include="..\Fjord.Storage\Fjord.Storage.csproj" />
  </ItemGroup>

</Project>
