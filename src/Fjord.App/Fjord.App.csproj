<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyTitle>Fjord</AssemblyTitle>
    <RootNamespace>Fjord.App</RootNamespace>
    <!-- What the user launches is called Fjord, not Fjord.App. -->
    <AssemblyName>Fjord</AssemblyName>
  </PropertyGroup>

  <!--
    Both are Windows resources. Applied when building for Windows or for no runtime at all,
    which is the ordinary local build; naming them unconditionally makes a linux-x64 or
    osx-arm64 publish fail on a manifest the target platform has no idea what to do with.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('win'))">
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The .exe icon on Windows. The window icon is set separately, in code. -->
    <ApplicationIcon>Assets/fjord.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    How Fjord is shipped: one self-contained executable per platform, with no runtime to
    install and nothing to unpack.

    Trimming is off and must stay off. Commands are discovered by reflecting over
    [Command] attributes and invoked through MethodInfo, so the linker sees no call site
    for any of them — a trimmed build would drop the lot and produce an app whose every
    key press reports an unknown command. That is a silent failure at runtime, not a
    build error, which is why this is written down rather than left to whoever tries it.
  -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded so the window icon works from a single-file publish too. -->
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <!--
      The abstractions plus LoggerFactory, and nothing else. Not Logging.Console: it drags
      Configuration, Options and a formatter stack in to write to a console a WinExe has not
      got. The rolling-file provider under Logging/ is the only one shipped.
    -->
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Debug symbols and XML docs, out of the publish set.

    The property above only reaches assemblies we reference; SkiaSharp and HarfBuzz ship
    *native* .pdb files inside their NuGet packages and those arrive through a different
    item group entirely. That is 100 MB of symbols for libraries nobody is going to debug,
    beside an executable of 49 MB — the archive was larger than the program in it.
  -->
  <Target Name="DropSymbolsFromPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish
          Remove="@(ResolvedFileToPublish)"
          Condition="'%(Extension)' == '.pdb' or '%(Extension)' == '.xml'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Fjord.Commands\Fjord.Commands.csproj" />
    <ProjectReference Include="..\Fjord.Config\Fjord.Config.csproj" />
    <ProjectReference Include="..\Fjord.Core\Fjord.Core.csproj" />
    <ProjectReference Include="..\Fjord.Operations\Fjord.Operations.csproj" />
    <ProjectReference Include="..\Fjord.Platform\Fjord.Platform.csproj" />
    <ProjectReference Include="..\Fjord.Storage\Fjord.Storage.csproj" />
  </ItemGroup>

</Project>
